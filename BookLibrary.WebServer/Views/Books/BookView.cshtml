@model BookLibrary.WebServer.Models.Books.BookModel

<div class="container">
    <div class="row">
        <div class="col">                
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <textarea asp-for="Name"  rows="5" class="form-control"></textarea>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>  
            <div class="form-group">
                <label asp-for="Year" class="control-label"></label>
                <input asp-for="Year" class="form-control" style="margin: 2px 0 0 0;"/>
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>                    
        </div>
        <div class="col">
            
            <label class="control-label">
                Authors&nbsp;&nbsp;&nbsp;&nbsp;
            </label>
            <a onclick="addAuthor()">
                <img title="Add author" src="../img/add.png" />
            </a>      
            
            <div id="authors"></div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function() {
        var authors = @Html.Raw(Json.Serialize(Model?.Authors ?? new List<string>()));
        if (authors.length > 0){
            authors.forEach(function (author){
                addAuthor(author.trim());
            });
        } else {
            addAuthor();
        }
    });

    function deleteAuthor(obj){
        $(obj).parents( ".row" ).first().remove();
    }

    function addAuthor(author){
        if ($(".author").length > 4){
            return;
        }

        if(!author){
            author = '';
        }

        const authorInput = '<div class="row mb-2">' +
                            '<div class="col-11">' +
                                '<input name="Authors" class="form-control author" value="' + author + '" />' +
                            '</div>' +
                            '<div class="col-1">' +
                                '<a class="align-middle" onclick="deleteAuthor(this)">' +
                                    '<img title="Delete author" src="../img/delete.png" />' +
                                '</a>' +
                            '</div>' +
                        '</div>';

        $("#authors").append(authorInput);
        $(".author").last().focus();
    }
</script>
